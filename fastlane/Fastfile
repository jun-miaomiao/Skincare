# frozen_string_literal: true

default_platform(:ios)

platform :ios do
  desc "Archive and upload to App Store Connect (does not submit for review)"
  lane :upload_asc do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY"),
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    )

    profile_name = ENV.fetch("PROVISIONING_PROFILE_NAME")
    team_id = ENV.fetch("APPLE_TEAM_ID", "ALW3W7UU8D")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Skincare.xcodeproj",
      team_id: team_id,
      targets: ["Skincare"],
      bundle_identifier: "com.jun.Skincare",
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      build_configurations: ["Release"]
    )

    build_app(
      project: "Skincare.xcodeproj",
      scheme: "Skincare",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: "build",
      output_name: "Skincare.ipa",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          "com.jun.Skincare" => profile_name
        }
      }
    )

    upload_to_app_store(
      api_key: api_key,
      ipa: "build/Skincare.ipa",
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false
    )
  end
end
