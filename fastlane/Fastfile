# frozen_string_literal: true

default_platform(:ios)

platform :ios do
  desc "Archive and upload to App Store Connect (does not submit for review)"
  lane :upload_asc do
    require "base64"
    require "open3"

    raw_key = ENV.fetch("APP_STORE_CONNECT_KEY").to_s.strip
    raw_key = raw_key.gsub("\r\n", "\n").gsub("\\n", "\n")
    unless raw_key.include?("BEGIN PRIVATE KEY")
      decoded = Base64.decode64(raw_key)
      raw_key = decoded if decoded.include?("BEGIN PRIVATE KEY")
    end
    UI.user_error!("APP_STORE_CONNECT_KEY is not a valid .p8 PEM") unless raw_key.include?("BEGIN PRIVATE KEY")

    # GitHub Secrets sometimes strip PEM newlines; rebuild a valid PKCS8 PEM.
    if (m = raw_key.match(/-----BEGIN PRIVATE KEY-----\s*([A-Za-z0-9+\/=]+)\s*-----END PRIVATE KEY-----/m))
      body = m[1].gsub(/\s+/, "")
      wrapped = body.scan(/.{1,64}/).join("\n")
      raw_key = "-----BEGIN PRIVATE KEY-----\n#{wrapped}\n-----END PRIVATE KEY-----\n"
    end

    key_path = File.join(Dir.tmpdir, "AuthKey_#{ENV.fetch("APP_STORE_CONNECT_KEY_ID").strip}.p8")
    File.write(key_path, raw_key)
    _out, err, status = Open3.capture3("openssl", "pkey", "-in", key_path, "-noout")
    UI.user_error!("APP_STORE_CONNECT_KEY failed OpenSSL parse: #{err}") unless status.success?

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID").strip,
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID").strip,
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )

    team_id = ENV.fetch("APPLE_TEAM_ID", "ALW3W7UU8D").strip

    sigh(
      api_key: api_key,
      app_identifier: "com.jun.Skincare",
      readonly: false,
      force: true
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]
    UI.message("Using profile: #{profile_name}")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Skincare.xcodeproj",
      team_id: team_id,
      targets: ["Skincare"],
      bundle_identifier: "com.jun.Skincare",
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      build_configurations: ["Release"]
    )

    build_app(
      project: "Skincare.xcodeproj",
      scheme: "Skincare",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: "build",
      output_name: "Skincare.ipa",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          "com.jun.Skincare" => profile_name
        }
      }
    )

    upload_to_app_store(
      api_key: api_key,
      ipa: "build/Skincare.ipa",
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false
    )
  end
end
